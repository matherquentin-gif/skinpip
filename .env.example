# Copy to .env.local and fill in. Never commit real values: this repo is public.

# Postgres (Neon works). Pooled URL for the app, direct URL for Prisma CLI.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/skinpip?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST/skinpip?sslmode=require"

# Signs session cookies. At least 32 random characters, e.g. `openssl rand -base64 48`.
SESSION_SECRET=""

# Public origin, no trailing slash. Steam login returns here and verifies it,
# so it must match the URL people actually use (set it per Vercel environment).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Stripe (the webhook refuses all events until both are set).
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Only for scripts/create-db.mjs: an admin connection to the server's default DB.
# ADMIN_DATABASE_URL=""

# Allow `npm run seed` against a production database (it wipes marketplace tables).
# SEED_DEMO=1
